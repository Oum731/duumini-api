# Déploiement combiné (API + site) sur hébergement mutualisé type cPanel
# (Nindohost) : la base de données est sur le MÊME serveur que l'app,
# donc DB_HOST doit être "localhost" - PAS un hôte distant (ancien
# Hostinger, Render, etc.). C'est l'erreur la plus fréquente ici.

NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://duumini.com

# --- Base de données (obligatoire) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Ancienne base (Render/Hostinger) - UNIQUEMENT pour
# src/scripts/syncFromOldDb.js, qui copie les données vers DB_* ci-dessus.
# Ne jamais utiliser ces identifiants pour l'app elle-même.
OLD_DB_HOST=
OLD_DB_PORT=3306
OLD_DB_USER=
OLD_DB_PASSWORD=
OLD_DB_NAME=
OLD_DB_SSL=

# --- JWT (obligatoire) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Cloudinary (optionnel, upload d'images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio (optionnel, SMS/OTP/WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SID=
TWILIO_WHATSAPP_FROM=

# --- IA / Ads (mettre OFF tant que non utilisé, évite d'exiger les clés Meta/OpenAI) ---
DUUMINI_AI_MODE=OFF
OPENAI_API_KEY=
META_AD_ACCOUNT_ID=
META_AD_ACCESS_TOKEN=

# --- Cron / worker (0 = désactivé) ---
RUN_CRON=0
RUN_WORKER=0
